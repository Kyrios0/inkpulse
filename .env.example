# Read-only credential used by the E1001 display.
INKPULSE_DEVICE_TOKEN=

# One write-only credential for Codex and Claude usage. Set the same value on
# the PC and server; keep it distinct from INKPULSE_DEVICE_TOKEN.
INKPULSE_AI_INGEST_TOKEN=
# Public HTTPS ingest URL used only on the PC. The /codex path is retained
# for compatibility with existing Nginx ingress; the payload carries both.
INKPULSE_AI_INGEST_URL=https://display.example.com/api/v1/metrics/codex
# Optional path to the local Codex CLI executable.
# INKPULSE_CODEX_COMMAND=codex
# Shared PC collector cadence while its watch process is running.
INKPULSE_AI_INTERVAL_SECONDS=60
# Measurements older than this are marked offline on rendered pages.
INKPULSE_CODEX_STALE_SECONDS=180

# Claude Desktop uses the same collector and write-only token as Codex.
# Auto-discovers Claude Desktop's plan-usage-history.json on Windows/macOS/Linux.
# INKPULSE_CLAUDE_USAGE_FILE=/absolute/path/to/plan-usage-history.json
# Desktop history was observed at roughly 15-minute intervals; allow two samples.
INKPULSE_CLAUDE_STALE_SECONDS=1800

# Keyless US-stock adapter settings.
INKPULSE_STOCK_SYMBOLS=JNJ,JPM,META,PG,XLP
# Matches the provider's five-minute chart bars. Polling faster normally
# repeats the same bar and increases rate-limit risk.
INKPULSE_STOCK_REFRESH_SECONDS=300
# The device cadence is independent. A fixed 300-second interval is
# freshness-first and likely unsuitable for long battery life; see
# docs/battery-life.md before selecting a production value.
INKPULSE_DISPLAY_REFRESH_SECONDS=60
INKPULSE_DATA_DIR=./data
